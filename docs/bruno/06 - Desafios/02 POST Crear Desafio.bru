meta {
  name: POST Crear Desafío
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/desafios
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Cookie: {{authCookie}}
}

body:json {
  {
    "equipo_retado_id": "{{equipoId}}",
    "cancha_id": "{{canchaId}}",
    "deporte": "basketball",
    "formato": "3v3",
    "fecha": "2026-06-15T18:00:00.000Z",
    "mensaje": "Los retamos en su cancha. ¿Aceptan el desafío?"
  }
}
