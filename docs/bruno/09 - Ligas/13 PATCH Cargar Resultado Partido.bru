meta {
  name: PATCH Cargar Resultado de Partido
  type: http
  seq: 17
}

patch {
  url: {{baseUrl}}/ligas/{{ligaId}}/partidos/{{partidoId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Cookie: {{authCookie}}
}

body:json {
  {
    "puntos_local": 78,
    "puntos_visitante": 65,
    "fecha": "2026-07-10T19:00:00.000Z",
    "cancha_id": "{{canchaId}}"
  }
}
