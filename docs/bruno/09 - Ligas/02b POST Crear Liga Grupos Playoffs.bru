meta {
  name: POST Crear Liga Grupos + Playoffs
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/ligas
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Cookie: {{authCookie}}
}

body:json {
  {
    "nombre": "Copa Santiago 2026",
