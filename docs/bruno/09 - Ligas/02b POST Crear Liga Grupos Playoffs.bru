    "max_equipos": 16,
    "inscripcion_publica": false,
    "fecha_inicio": "2026-08-01",
    "fecha_fin": "2026-10-31",
    "num_grupos": 4,
    "equipos_clasifican": 2,
    "puntos_victoria": 3,
