meta {
  name: POST Invitación por WhatsApp
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/invitaciones
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Cookie: {{authCookie}}
}

body:json {
  {
    "equipo_id": "{{equipoId}}",
    "metodo": "whatsapp",
    "valor": "+56912345678"
  }
}
