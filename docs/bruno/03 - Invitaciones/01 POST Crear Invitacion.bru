meta {
  name: POST Crear Invitación
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/invitaciones
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Cookie: {{authCookie}}
}

body:json {
  {
    "equipo_id": "{{equipoId}}",
    "metodo": "email",
    "valor": "jugador@ejemplo.com"
  }
}
